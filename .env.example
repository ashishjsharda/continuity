# Google / Gemini
GOOGLE_API_KEY=your_google_ai_studio_or_vertex_key
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# ClickHouse connection (used by mcp-clickhouse)
CLICKHOUSE_HOST=your-service.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your_password
CLICKHOUSE_SECURE=true
CLICKHOUSE_DATABASE=production_memory

# Optional: enable write access for the agent (demo only)
CLICKHOUSE_ALLOW_WRITE_ACCESS=true
